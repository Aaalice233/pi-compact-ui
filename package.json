{
  "name": "pi-compact-ui",
  "version": "0.6.1",
  "description": "Compact tree-shaped reasoning and tool-call UI for the Pi Coding Agent (Aaalice233 fork: plugin compatibility, configurable native tools, long-session performance)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "terminal-ui",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaalice233/pi-compact-ui.git"
  },
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --no-warnings --import ./test/setup.ts --test test/*.test.ts",
    "bench": "node --no-warnings --import ./test/setup.ts scripts/bench.ts",
    "preview": "node --no-warnings --import ./test/setup.ts scripts/preview.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
